@page "/payslip"
@attribute [Authorize(Policy = "Admin")]

@using Web_JbcHrms.Models
@using CsvHelper
@using System.Globalization
@using System.IO
@using System.Linq
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime JSRuntime
@inject HttpClient Http

<PageTitle>Monthly Pay Slip</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="h3 mb-1"><i class="bi bi-receipt-cutoff text-primary"></i> Monthly Pay Slip</h2>
            <p class="text-muted mb-0">Generate monthly employee payslips with customizable earnings and deductions</p>
        </div>
        <div class="d-flex gap-2">
            <InputFile id="@FileInputId" accept=".csv" style="position: absolute; left: -9999px;" OnChange="HandleFileChange" />
            <label for="@FileInputId" class="btn btn-primary mb-0">
                <i class="bi bi-upload"></i> Upload CSV
            </label>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(statusSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
            @statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
        </div>
    }

    <!-- Pay Period & Employee Selection Row -->
    <div class="row g-3 mb-4">
        <!-- Pay Period Selector -->
        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0 fs-6"><i class="bi bi-calendar-month"></i> 1. Select Pay Period</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Month</label>
                        <select class="form-select" @bind="selectedMonth">
                            @foreach (var month in months)
                            {
                                <option value="@month">@month</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Year</label>
                        <select class="form-select" @bind="selectedYear">
                            @for (int y = DateTime.Now.Year - 2; y <= DateTime.Now.Year + 2; y++)
                            {
                                <option value="@y">@y</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label fw-bold">Issue / Pay Date</label>
                        <input type="date" class="form-control" @bind="issueDate" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Employee Search & Selection -->
        <div class="col-lg-8">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0 fs-6"><i class="bi bi-person-search"></i> 2. Search & Select Employee</h5>
                </div>
                <div class="card-body">
                    <div class="input-group mb-3">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="Search by name or ID..." 
                               @bind="searchQuery" @bind:event="oninput" @onkeydown="HandleSearchKeyDown" />
                        <button class="btn btn-primary" type="button" @onclick="PerformSearch">Search</button>
                    </div>

                    @if (searchResults != null && searchResults.Any())
                    {
                        <div class="list-group mb-3" style="max-height: 200px; overflow-y: auto;">
                            @foreach (var emp in searchResults)
                            {
                                <button type="button" 
                                        class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(selectedEmployee?.EmployeeID == emp.EmployeeID ? "active" : "")"
                                        @onclick="() => SelectEmployee(emp)">
                                    <div>
                                        <strong>#@emp.EmployeeID - @emp.Salutation @emp.FirstName @emp.LastName</strong>
                                        <div class="small @(selectedEmployee?.EmployeeID == emp.EmployeeID ? "text-light" : "text-muted")">
                                            @emp.Designation | Gross: @emp.Gross.ToString("N0") ৳
                                        </div>
                                    </div>
                                    <span class="badge @(selectedEmployee?.EmployeeID == emp.EmployeeID ? "bg-light text-dark" : "bg-primary") rounded-pill">
                                        Select
                                    </span>
                                </button>
                            }
                        </div>
                    }

                    @if (selectedEmployee != null)
                    {
                        <div class="p-3 bg-light rounded border border-success">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="badge bg-success mb-1">Selected Employee</span>
                                    <h5 class="mb-1 text-dark">@selectedEmployee.Salutation @selectedEmployee.FirstName @selectedEmployee.LastName (#@selectedEmployee.EmployeeID)</h5>
                                    <div class="text-muted small">
                                        <strong>Designation:</strong> @selectedEmployee.Designation | 
                                        <strong>Joining Date:</strong> @selectedEmployee.JoiningDate.ToString("dd MMM yyyy")
                                    </div>
                                </div>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSelectedEmployee">
                                    <i class="bi bi-x-circle"></i> Change
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-person-badge fs-2 d-block mb-2 text-secondary"></i>
                            <p class="mb-0 fw-semibold">No employee selected.</p>
                            <small class="text-muted">Type an employee name or ID in the search box above to choose an employee.</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (selectedEmployee != null)
    {
        <!-- Payslip Customization Row -->
        <div class="row g-3 mb-4">
            <!-- Left: Earnings Breakdown (Colorful UI) -->
            <div class="col-lg-6">
                <div class="card shadow-sm h-100 border-primary">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <span class="fw-bold"><i class="bi bi-wallet2"></i> Earnings & Allowances</span>
                        <span class="badge bg-light text-primary fs-6">@TotalEarnings.ToString("N2") BDT</span>
                    </div>
                    <div class="card-body">
                        <!-- Standard Fixed Components -->
                        <div class="table-responsive mb-3">
                            <table class="table table-sm table-borderless align-middle mb-0">
                                <tbody>
                                    <tr>
                                        <td class="text-muted" style="width: 50%;">Basic Salary:</td>
                                        <td class="text-end fw-semibold">
                                            <input type="number" class="form-control form-control-sm text-end d-inline-block" style="width: 140px;" @bind="basicSalary" @bind:event="oninput" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">House Rent Allowance:</td>
                                        <td class="text-end fw-semibold">
                                            <input type="number" class="form-control form-control-sm text-end d-inline-block" style="width: 140px;" @bind="houseAllowance" @bind:event="oninput" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Medical Allowance:</td>
                                        <td class="text-end fw-semibold">
                                            <input type="number" class="form-control form-control-sm text-end d-inline-block" style="width: 140px;" @bind="medicalAllowance" @bind:event="oninput" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Travel Allowance:</td>
                                        <td class="text-end fw-semibold">
                                            <input type="number" class="form-control form-control-sm text-end d-inline-block" style="width: 140px;" @bind="travelAllowance" @bind:event="oninput" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">General Miscellaneous:</td>
                                        <td class="text-end fw-semibold">
                                            <input type="number" class="form-control form-control-sm text-end d-inline-block" style="width: 140px;" @bind="generalMiscellaneous" @bind:event="oninput" />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Additional Miscellaneous Items (Optional Multiple Inputs!) -->
                        <div class="p-3 mb-3 bg-light rounded border border-primary-subtle">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold small text-primary"><i class="bi bi-plus-circle-dotted"></i> Additional Miscellaneous (Optional):</span>
                                <span class="badge bg-primary">Extra: @miscellaneousItems.Sum(m => m.Amount).ToString("N2") ৳</span>
                            </div>

                            @if (miscellaneousItems.Any())
                            {
                                <div class="table-responsive mb-2">
                                    <table class="table table-sm table-hover align-middle mb-0 bg-white border">
                                        <tbody>
                                            @foreach (var item in miscellaneousItems)
                                            {
                                                <tr>
                                                    <td>
                                                        <input type="text" class="form-control form-control-sm" @bind="item.Description" placeholder="Description" />
                                                    </td>
                                                    <td style="width: 130px;">
                                                        <input type="number" class="form-control form-control-sm text-end" @bind="item.Amount" @bind:event="oninput" placeholder="Amount ৳" />
                                                    </td>
                                                    <td style="width: 35px;" class="text-center">
                                                        <button type="button" class="btn btn-sm btn-outline-danger p-1" title="Remove" @onclick="() => miscellaneousItems.Remove(item)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="small text-muted mb-2">No additional miscellaneous items added.</div>
                            }

                            <!-- Add New Miscellaneous Input Group -->
                            <div class="input-group input-group-sm mb-2">
                                <input type="text" class="form-control" placeholder="Extra misc description (e.g. Utility/Internet)..." @bind="newMiscTitle" />
                                <input type="number" class="form-control" style="max-width: 120px;" placeholder="Amount ৳" @bind="newMiscAmount" />
                                <button class="btn btn-outline-primary" type="button" @onclick="AddMiscellaneousItem">
                                    <i class="bi bi-plus-lg"></i> Add Extra Misc
                                </button>
                            </div>
                            <div class="d-flex flex-wrap gap-1">
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size: 0.75rem;" @onclick='() => AddQuickMisc("Internet Allowance", 500)'>+ Internet (500 ৳)</button>
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size: 0.75rem;" @onclick='() => AddQuickMisc("Office Expense", 300)'>+ Office Exp (300 ৳)</button>
                            </div>
                        </div>

                        <!-- Subtotal: Gross Salary -->
                        <div class="d-flex justify-content-between align-items-center py-2 px-3 bg-primary bg-opacity-10 rounded border border-primary mb-3">
                            <span class="fw-bold text-primary">Total Gross Salary:</span>
                            <span class="fw-bold text-primary fs-6">@GrossSalary.ToString("N2") ৳</span>
                        </div>

                        <!-- Transport Allowance -->
                        <div class="table-responsive mb-3">
                            <table class="table table-sm table-borderless align-middle mb-0">
                                <tbody>
                                    <tr>
                                        <td class="text-muted" style="width: 50%;">Transport Allowance:</td>
                                        <td class="text-end fw-semibold">
                                            <input type="number" class="form-control form-control-sm text-end d-inline-block" style="width: 140px;" @bind="transportAllowance" @bind:event="oninput" />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Performance & Other Allowances (Multiple Inputs!) -->
                        <div class="p-3 bg-light rounded border border-info-subtle">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold small text-info-emphasis"><i class="bi bi-star-fill text-warning"></i> Performance / Other Allowances:</span>
                                <span class="badge bg-info text-dark">Total: @TotalPerformanceAllowances.ToString("N2") ৳</span>
                            </div>

                            @if (performanceAllowanceItems.Any())
                            {
                                <div class="table-responsive mb-2">
                                    <table class="table table-sm table-hover align-middle mb-0 bg-white border">
                                        <tbody>
                                            @foreach (var allowance in performanceAllowanceItems)
                                            {
                                                <tr>
                                                    <td>
                                                        <input type="text" class="form-control form-control-sm" @bind="allowance.Description" placeholder="Allowance Title" />
                                                    </td>
                                                    <td style="width: 130px;">
                                                        <input type="number" class="form-control form-control-sm text-end" @bind="allowance.Amount" @bind:event="oninput" placeholder="Amount ৳" />
                                                    </td>
                                                    <td style="width: 35px;" class="text-center">
                                                        <button type="button" class="btn btn-sm btn-outline-danger p-1" title="Remove" @onclick="() => performanceAllowanceItems.Remove(allowance)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="small text-muted mb-2">No performance or other allowances added.</div>
                            }

                            <!-- Add New Performance Allowance Input Group -->
                            <div class="input-group input-group-sm mb-2">
                                <input type="text" class="form-control" placeholder="Allowance name (e.g. Festival Bonus)..." @bind="newAllowanceTitle" />
                                <input type="number" class="form-control" style="max-width: 120px;" placeholder="Amount ৳" @bind="newAllowanceAmount" />
                                <button class="btn btn-outline-info text-dark" type="button" @onclick="AddPerformanceAllowanceItem">
                                    <i class="bi bi-plus-lg"></i> Add Allowance
                                </button>
                            </div>
                            <div class="d-flex flex-wrap gap-1">
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 0.75rem;" @onclick='() => AddQuickAllowance("Performance Allowance", 5000)'>+ Performance (5,000 ৳)</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 0.75rem;" @onclick='() => AddQuickAllowance("Team Lead Allowance", 15000)'>+ Team Lead (15,000 ৳)</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 0.75rem;" @onclick='() => AddQuickAllowance("Festival Bonus", 10000)'>+ Festival Bonus (10,000 ৳)</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Deductions (Colorful UI) -->
            <div class="col-lg-6">
                <div class="card shadow-sm h-100 border-danger">
                    <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
                        <span class="fw-bold"><i class="bi bi-dash-circle"></i> Monthly Deductions</span>
                        <span class="badge bg-light text-danger fs-6">@TotalDeductions.ToString("N2") BDT</span>
                    </div>
                    <div class="card-body">
                        <!-- Standard Tax Deduction -->
                        <div class="mb-3 pb-2 border-bottom">
                            <label class="form-label text-muted mb-1 d-flex justify-content-between">
                                <span>Monthly Tax Deduction</span>
                                <span class="fw-bold text-danger">@monthlyTaxDeduction.ToString("N2") ৳</span>
                            </label>
                            <input type="number" class="form-control form-control-sm text-end" @bind="monthlyTaxDeduction" @bind:event="oninput" />
                        </div>

                        <!-- Quick Add Buttons -->
                        <div class="mb-3">
                            <label class="form-label small text-muted d-block mb-1">Quick Add Common Deductions:</label>
                            <div class="d-flex flex-wrap gap-1">
                                <button type="button" class="btn btn-sm btn-outline-warning text-dark" @onclick='() => AddQuickDeduction("Additional Home Office", 200)'>
                                    + Additional Home Office (200 ৳)
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-warning text-dark" @onclick='() => AddQuickDeduction("Absent / Leave Without Pay", 1000)'>
                                    + Absent (1,000 ৳)
                                </button>
                            </div>
                        </div>

                        <!-- Custom Deductions List -->
                        <h6 class="fs-6 text-muted mb-2">Additional Variable Deductions (@customDeductions.Count):</h6>
                        @if (customDeductions.Any())
                        {
                            <div class="table-responsive mb-3">
                                <table class="table table-sm table-hover align-middle mb-0 bg-white border">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Description / Reason</th>
                                            <th class="text-end" style="width: 140px;">Amount (BDT)</th>
                                            <th style="width: 40px;"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var deduction in customDeductions)
                                        {
                                            <tr>
                                                <td>
                                                    <input type="text" class="form-control form-control-sm" @bind="deduction.Description" />
                                                </td>
                                                <td class="text-end">
                                                    <input type="number" class="form-control form-control-sm text-end" @bind="deduction.Amount" @bind:event="oninput" />
                                                </td>
                                                <td class="text-center">
                                                    <button type="button" class="btn btn-sm btn-outline-danger p-1" title="Remove" @onclick="() => customDeductions.Remove(deduction)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-light border small text-muted py-2 mb-3">
                                No extra deductions added for this month.
                            </div>
                        }

                        <!-- Add Deduction Input Group -->
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control" placeholder="Deduction reason (e.g. Extra Home Office)..." @bind="newDeductionTitle" />
                            <input type="number" class="form-control" style="max-width: 120px;" placeholder="Amount ৳" @bind="newDeductionAmount" />
                            <button class="btn btn-danger" type="button" @onclick="AddCustomDeduction">
                                <i class="bi bi-plus-lg"></i> Add
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Net Summary & Action Panel (Colorful UI) -->
        <div class="card shadow-sm border-success mb-5">
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col-lg-7">
                        <div class="d-flex flex-wrap gap-4 mb-2">
                            <div>
                                <span class="text-muted small d-block">Total Earnings (A)</span>
                                <span class="fs-5 fw-bold text-primary">@TotalEarnings.ToString("N2") ৳</span>
                            </div>
                            <div class="border-start ps-3">
                                <span class="text-muted small d-block">Total Deductions (B)</span>
                                <span class="fs-5 fw-bold text-danger">@TotalDeductions.ToString("N2") ৳</span>
                            </div>
                            <div class="border-start ps-3">
                                <span class="text-muted small d-block">NET PAYABLE (A - B)</span>
                                <span class="fs-3 fw-bold text-success">@NetPayable.ToString("N2") BDT</span>
                            </div>
                        </div>
                        <p class="text-muted mb-0 small">
                            <strong>In Words:</strong> @NumberToWords(NetPayable) Taka Only.
                        </p>
                    </div>
                    <div class="col-lg-5 text-lg-end mt-3 mt-lg-0">
                        <button type="button" class="btn btn-outline-primary btn-lg me-2" @onclick="OpenPrintPreview">
                            <i class="bi bi-eye"></i> Preview Pay Slip
                        </button>
                        <button type="button" class="btn btn-success btn-lg" @onclick="DirectPrint">
                            <i class="bi bi-printer"></i> Print Pay Slip
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Print Preview Modal (Clean Black & White Document inside Modal) -->
<div class="modal fade" id="paySlipPreviewModal" tabindex="-1" aria-labelledby="paySlipPreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="paySlipPreviewModalLabel">
                    <i class="bi bi-file-earmark-text"></i> Pay Slip Print Preview - @selectedEmployee?.FirstName @selectedEmployee?.LastName (@selectedMonth @selectedYear)
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0" style="max-height: 80vh; overflow-y: auto; background-color: #555555;">
                <div id="paySlipPrintArea" class="payslip-print-root py-2">
                    <style>
                        /* Balanced B&W Pay Slip Styles - Times New Roman & Fits strictly on 1 A4 Page */
                        .payslip-bw-container {
                            color: #000000 !important;
                            background-color: #ffffff !important;
                            font-family: "Times New Roman", Times, serif !important;
                        }
                        .payslip-bw-container,
                        .payslip-bw-container * {
                            color: #000000 !important;
                            font-family: "Times New Roman", Times, serif !important;
                        }
                        .payslip-bw-info-box {
                            border: 1.5px solid #000000 !important;
                            padding: 6px 10px !important;
                            background-color: #ffffff !important;
                            margin-bottom: 10px !important;
                        }
                        .payslip-bw-table {
                            border: 1.5px solid #000000 !important;
                            border-collapse: collapse !important;
                            width: 100% !important;
                            font-size: 10.5pt !important;
                            margin-bottom: 0 !important;
                        }
                        .payslip-bw-table th,
                        .payslip-bw-table td {
                            border: 1px solid #000000 !important;
                            padding: 3.5px 7px !important;
                            vertical-align: middle !important;
                            color: #000000 !important;
                            line-height: 1.3 !important;
                        }
                        .payslip-bw-table thead th {
                            background-color: #f2f2f2 !important;
                            font-weight: 700 !important;
                            text-transform: uppercase !important;
                            font-size: 9.5pt !important;
                            border-bottom: 1.5px solid #000000 !important;
                            color: #000000 !important;
                        }
                        .payslip-bw-table tr.total-row td {
                            font-weight: 700 !important;
                            border-top: 1.5px solid #000000 !important;
                            border-bottom: 2px solid #000000 !important;
                            background-color: #f2f2f2 !important;
                            color: #000000 !important;
                        }
                        .payslip-bw-net-box {
                            border: 1.5px solid #000000 !important;
                            padding: 7px 12px !important;
                            background-color: #ffffff !important;
                            margin: 10px 0 !important;
                        }
                        @@media print {
                            @@page {
                                size: A4 portrait;
                                margin: 0mm !important;
                            }
                            html, body {
                                width: 210mm !important;
                                height: 297mm !important;
                                margin: 0 !important;
                                padding: 0 !important;
                                overflow: hidden !important;
                                background-color: #ffffff !important;
                                font-family: "Times New Roman", Times, serif !important;
                                -webkit-print-color-adjust: exact !important;
                                print-color-adjust: exact !important;
                            }
                            #paySlipPrintArea,
                            .payslip-print-root {
                                padding: 0 !important;
                                margin: 0 !important;
                                width: 210mm !important;
                                height: 297mm !important;
                                max-height: 297mm !important;
                                overflow: hidden !important;
                            }
                            #paySlipPrintArea .report-a4-container,
                            .payslip-print-root .report-a4-container {
                                padding: 0 !important;
                                margin: 0 !important;
                                width: 210mm !important;
                                height: 297mm !important;
                                max-height: 297mm !important;
                                background: transparent !important;
                                overflow: hidden !important;
                            }
                            #paySlipPrintArea .report-a4-page,
                            .payslip-print-root .report-a4-page {
                                width: 210mm !important;
                                height: 297mm !important;
                                max-height: 297mm !important;
                                min-height: 297mm !important;
                                padding: 8mm 12.9mm 10mm 12.9mm !important;
                                box-sizing: border-box !important;
                                page-break-inside: avoid !important;
                                break-inside: avoid !important;
