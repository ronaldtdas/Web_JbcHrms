@code {
    private const string FileInputId = "paySlipFileInput";
    private const long MaxFileSize = 10 * 1024 * 1024;

    private List<Employee> allEmployees = new();
    private List<Employee> searchResults = new();
    private string searchQuery = string.Empty;
    private Employee? selectedEmployee = null; // No default employee selected

    private string[] months = new[] { "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" };
    private string selectedMonth = DateTime.Now.ToString("MMMM");
    private int selectedYear = DateTime.Now.Year;
    private DateTime issueDate = DateTime.Today;

    // Fixed Earnings Components
    private decimal basicSalary;
    private decimal houseAllowance;
    private decimal medicalAllowance;
    private decimal travelAllowance;
    private decimal generalMiscellaneous;
    private decimal transportAllowance;

    // Dynamic Miscellaneous Items
    private List<PaySlipItem> miscellaneousItems = new();
    private string newMiscTitle = string.Empty;
    private decimal newMiscAmount = 0;

    // Dynamic Performance / Other Allowance Items
    private List<PaySlipItem> performanceAllowanceItems = new();
    private string newAllowanceTitle = string.Empty;
    private decimal newAllowanceAmount = 0;

    // Dynamic Deductions
    private decimal monthlyTaxDeduction;
    private List<PaySlipItem> customDeductions = new();
    private string newDeductionTitle = string.Empty;
    private decimal newDeductionAmount = 0;

    private string? statusMessage;
    private bool statusSuccess;

    private decimal TotalMiscellaneous => generalMiscellaneous + miscellaneousItems.Sum(m => m.Amount);
    private decimal GrossSalary => basicSalary + houseAllowance + medicalAllowance + travelAllowance + TotalMiscellaneous;
    private decimal TotalPerformanceAllowances => performanceAllowanceItems.Sum(p => p.Amount);
    private decimal TotalEarnings => GrossSalary + transportAllowance + TotalPerformanceAllowances;
    private decimal TotalDeductions => monthlyTaxDeduction + customDeductions.Sum(d => d.Amount);
    private decimal NetPayable => Math.Max(0, TotalEarnings - TotalDeductions);

    protected override async Task OnInitializedAsync()
    {
        await LoadEmployeesFromStorage();
        selectedEmployee = null;
    }

    private async Task LoadEmployeesFromStorage()
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "employees");
            if (!string.IsNullOrEmpty(json))
            {
                var list = JsonSerializer.Deserialize<List<Employee>>(json);
                if (list != null && list.Any())
                {
                    allEmployees = list;
                    searchResults = allEmployees.Take(5).ToList();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error reading employees from storage: {ex.Message}");
        }
    }

    private async Task HandleFileChange(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            await using var stream = file.OpenReadStream(MaxFileSize);
            using var reader = new StreamReader(stream);
            var content = await reader.ReadToEndAsync();

            using var csv = new CsvReader(new StringReader(content), CultureInfo.InvariantCulture);
            allEmployees = csv.GetRecords<Employee>().ToList();

            var json = JsonSerializer.Serialize(allEmployees);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "employees", json);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "lastFileName", file.Name);

            searchResults = allEmployees.Take(5).ToList();
            statusSuccess = true;
            statusMessage = $"Uploaded {allEmployees.Count} employees from '{file.Name}'. Please search and select an employee.";
            selectedEmployee = null;
        }
        catch (Exception ex)
        {
            statusSuccess = false;
            statusMessage = $"Error processing CSV: {ex.Message}";
        }
    }

    private void PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            searchResults = allEmployees.Take(5).ToList();
            return;
        }

        var query = searchQuery.Trim().ToLowerInvariant();
        searchResults = allEmployees
            .Where(e =>
                e.EmployeeID.ToString().Contains(query) ||
                e.FirstName.ToLowerInvariant().Contains(query) ||
                e.LastName.ToLowerInvariant().Contains(query) ||
                $"{e.FirstName} {e.LastName}".ToLowerInvariant().Contains(query) ||
                e.Designation.ToLowerInvariant().Contains(query))
            .Take(10)
            .ToList();
    }

    private void HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            PerformSearch();
        }
    }

    private void SelectEmployee(Employee emp)
    {
        selectedEmployee = emp;
        basicSalary = emp.BasicSalary;
        houseAllowance = emp.HouseAllowance;
        medicalAllowance = emp.MedicalAllowance;
        travelAllowance = emp.TravelAllowance;
        generalMiscellaneous = emp.Miscellaneous; // Hardcoded fixed field like Travel Allowance
        transportAllowance = emp.TransportAllowance;
        monthlyTaxDeduction = emp.MonthlyTaxDeduction;

        // Reset any additional dynamic miscellaneous items
        miscellaneousItems.Clear();

        // Populate Performance / Other Allowances
        performanceAllowanceItems.Clear();
        if (emp.PerformanceAllowance > 0)
        {
            performanceAllowanceItems.Add(new PaySlipItem { Description = "Performance Allowance", Amount = emp.PerformanceAllowance });
        }

        // Deductions
        customDeductions.Clear();
    }

    private void ClearSelectedEmployee()
    {
        selectedEmployee = null;
        generalMiscellaneous = 0;
        miscellaneousItems.Clear();
        performanceAllowanceItems.Clear();
        customDeductions.Clear();
    }

    // Miscellaneous Methods
    private void AddQuickMisc(string title, decimal amount)
    {
        miscellaneousItems.Add(new PaySlipItem { Description = title, Amount = amount });
    }

    private void AddMiscellaneousItem()
    {
        if (string.IsNullOrWhiteSpace(newMiscTitle) || newMiscAmount <= 0) return;
        miscellaneousItems.Add(new PaySlipItem { Description = newMiscTitle.Trim(), Amount = newMiscAmount });
        newMiscTitle = string.Empty;
        newMiscAmount = 0;
    }

    // Performance Allowance Methods
    private void AddQuickAllowance(string title, decimal amount)
    {
        performanceAllowanceItems.Add(new PaySlipItem { Description = title, Amount = amount });
    }

    private void AddPerformanceAllowanceItem()
    {
        if (string.IsNullOrWhiteSpace(newAllowanceTitle) || newAllowanceAmount <= 0) return;
        performanceAllowanceItems.Add(new PaySlipItem { Description = newAllowanceTitle.Trim(), Amount = newAllowanceAmount });
        newAllowanceTitle = string.Empty;
        newAllowanceAmount = 0;
    }

    // Deduction Methods
    private void AddQuickDeduction(string title, decimal amount)
    {
        customDeductions.Add(new PaySlipItem { Description = title, Amount = amount });
    }

    private void AddCustomDeduction()
    {
        if (string.IsNullOrWhiteSpace(newDeductionTitle) || newDeductionAmount <= 0) return;
        customDeductions.Add(new PaySlipItem { Description = newDeductionTitle.Trim(), Amount = newDeductionAmount });
        newDeductionTitle = string.Empty;
        newDeductionAmount = 0;
    }

    // Print & Preview
    private async Task OpenPrintPreview()
    {
        await JSRuntime.InvokeVoidAsync("showModal", "paySlipPreviewModal");
    }

    private async Task DirectPrint()
    {
        await JSRuntime.InvokeVoidAsync("showModal", "paySlipPreviewModal");
        await Task.Delay(200);
        await ConfirmPrint();
    }

    private async Task ConfirmPrint()
    {
        await JSRuntime.InvokeVoidAsync("hideModal", "paySlipPreviewModal");
        await Task.Delay(100);
        var title = $"Pay Slip - {selectedEmployee?.FirstName} {selectedEmployee?.LastName} - {selectedMonth} {selectedYear}";
        await JSRuntime.InvokeVoidAsync("printReport", "paySlipPrintArea", title);
    }

    private string NumberToWords(decimal number)
    {
        if (number <= 0) return "Zero";

        string[] units = { "", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine" };
        string[] teens = { "Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen", "Sixteen", "Seventeen", "Eighteen", "Nineteen" };
        string[] tens = { "", "", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy", "Eighty", "Ninety" };

        string ConvertToWords(long n)
        {
            if (n < 10) return units[n];
            if (n < 20) return teens[n - 10];
            if (n < 100) return tens[n / 10] + (n % 10 != 0 ? " " + units[n % 10] : "");
            if (n < 1000) return units[n / 100] + " Hundred" + (n % 100 != 0 ? " " + ConvertToWords(n % 100) : "");
            if (n < 100000) return ConvertToWords(n / 1000) + " Thousand" + (n % 1000 != 0 ? " " + ConvertToWords(n % 1000) : "");
            if (n < 10000000) return ConvertToWords(n / 100000) + " Lakh" + (n % 100000 != 0 ? " " + ConvertToWords(n % 100000) : "");
            return ConvertToWords(n / 10000000) + " Crore" + (n % 10000000 != 0 ? " " + ConvertToWords(n % 10000000) : "");
        }

        long wholeNumber = (long)Math.Floor(number);
        return ConvertToWords(wholeNumber);
    }

    private string GetFullName(Employee? emp)
    {
        if (emp == null) return string.Empty;
        if (!string.IsNullOrWhiteSpace(emp.LastName) && emp.FirstName.EndsWith(emp.LastName, StringComparison.OrdinalIgnoreCase))
        {
            return $"{emp.Salutation} {emp.FirstName}".Trim();
        }
        return $"{emp.Salutation} {emp.FirstName} {emp.LastName}".Trim();
    }
}
